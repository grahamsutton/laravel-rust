use laravel::prelude::*;

pub fn config() -> Value {
    json!({
        /*
        |--------------------------------------------------------------------------
        | Default Concurrency Driver
        |--------------------------------------------------------------------------
        |
        | This option determines the default concurrency driver that will be used
        | by Laravel's concurrency functions. By default, concurrent work will
        | be spawned onto the Tokio runtime as tasks which return their results.
        |
        | Supported: "tokio", "sync"
        |
        */

        "default": env("CONCURRENCY_DRIVER", "tokio"),
    })
}
